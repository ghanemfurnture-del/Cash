# =====================================================================
# Offline-first Arabic Accounting & ERP (.env.example)
# Copy this file to .env.local for local development.
# NEVER commit .env or .env.local to version control!
# =====================================================================

# Supabase Client Configuration (Public/Anon Key ONLY)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Company & Application Defaults
VITE_APP_NAME="نظام الخزينة والمحاسبة"
VITE_DEFAULT_LOCALE=ar
VITE_DEFAULT_CURRENCY=EGP

# Local Signing Agent (Running on the designated company PC with hardware USB token)
VITE_SIGNING_AGENT_URL=http://127.0.0.1:5199
